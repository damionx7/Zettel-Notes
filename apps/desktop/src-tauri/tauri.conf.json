{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zettel Notes",
  "version": "0.0.10",
  "identifier": "org.eu.thedoc.zettelnotes.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "plugins": {
    "cli": {
      "description": "Zettel Notes - Markdown notes for a Zettelkasten",
      "longDescription": "Markdown notes for a Zettelkasten, compatible with Zettel Notes for Android.\n\nUsage: zettel-notes [COMMAND] [OPTIONS]\n       zn [COMMAND] [OPTIONS]\n\nYou can create a symlink or alias 'zn' to 'zettel-notes' for shorter invocation.",
      "subcommands": {
        "open": {
          "description": "Open a file or folder in Zettel Notes",
          "args": [
            {
              "name": "path",
              "description": "Target file path",
              "index": 1,
              "takesValue": true,
              "required": true
            },
            {
              "name": "window-id",
              "description": "Target window id",
              "takesValue": true
            },
            {
              "name": "window",
              "description": "Target window id",
              "takesValue": true
            },
            {
              "name": "json",
              "description": "Print JSON receipt"
            },
            {
              "name": "timeout",
              "description": "Deadline in milliseconds (default 30000)",
              "takesValue": true
            },
            {
              "name": "wait",
              "description": "Wait for applied or visible content",
              "takesValue": true
            },
            {
              "name": "sha256",
              "description": "Expected decoded UTF-8 content SHA-256",
              "takesValue": true
            },
            {
              "name": "preview",
              "description": "Open in preview mode"
            }
          ]
        },
        "file": {
          "description": "File commands",
          "subcommands": {
            "open": {
              "description": "Open a file in Zettel Notes",
              "args": [
                {
                  "name": "path",
                  "description": "Target file path",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "window-id",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "window",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "json",
                  "description": "Print JSON receipt"
                },
                {
                  "name": "timeout",
                  "description": "Deadline in milliseconds (default 30000)",
                  "takesValue": true
                },
                {
                  "name": "wait",
                  "description": "Wait for applied or visible content",
                  "takesValue": true
                },
                {
                  "name": "sha256",
                  "description": "Expected decoded UTF-8 content SHA-256",
                  "takesValue": true
                },
                {
                  "name": "preview",
                  "description": "Open in preview mode"
                }
              ]
            },
            "status": {
              "description": "Query live file state",
              "args": [
                {
                  "name": "path",
                  "description": "Target file path",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "window-id",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "window",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "json",
                  "description": "Print JSON receipt"
                },
                {
                  "name": "timeout",
                  "description": "Deadline in milliseconds (default 30000)",
                  "takesValue": true
                },
                {
                  "name": "wait",
                  "description": "Wait for applied or visible content",
                  "takesValue": true
                },
                {
                  "name": "sha256",
                  "description": "Expected decoded UTF-8 content SHA-256",
                  "takesValue": true
                }
              ]
            },
            "wait": {
              "description": "Wait for target content to be applied and visible",
              "args": [
                {
                  "name": "path",
                  "description": "Target file path",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "window-id",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "window",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "json",
                  "description": "Print JSON receipt"
                },
                {
                  "name": "timeout",
                  "description": "Deadline in milliseconds (default 30000)",
                  "takesValue": true
                },
                {
                  "name": "wait",
                  "description": "Wait for applied or visible content",
                  "takesValue": true
                },
                {
                  "name": "sha256",
                  "description": "Expected decoded UTF-8 content SHA-256",
                  "takesValue": true
                }
              ]
            },
            "export": {
              "description": "Export a specific file and verify output",
              "args": [
                {
                  "name": "path",
                  "description": "Target file path",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "window-id",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "window",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "json",
                  "description": "Print JSON receipt"
                },
                {
                  "name": "timeout",
                  "description": "Deadline in milliseconds (default 30000)",
                  "takesValue": true
                },
                {
                  "name": "wait",
                  "description": "Wait for applied or visible content",
                  "takesValue": true
                },
                {
                  "name": "sha256",
                  "description": "Expected decoded UTF-8 content SHA-256",
                  "takesValue": true
                },
                {
                  "name": "format",
                  "description": "html, markdown, text, json, or jpg",
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "output",
                  "description": "Destination file path",
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "overwrite",
                  "description": "Allow replacing an existing export"
                }
              ]
            }
          }
        },
        "window": {
          "description": "Window commands",
          "subcommands": {
            "list": {
              "description": "Print windows with workspace paths"
            },
            "focus": {
              "description": "Focus a window",
              "args": [
                {
                  "name": "id",
                  "description": "Window id",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                }
              ]
            }
          }
        },
        "command": {
          "description": "GUI command commands",
          "subcommands": {
            "list": {
              "description": "Print registered GUI commands"
            },
            "execute": {
              "description": "Execute a registered GUI command",
              "args": [
                {
                  "name": "id",
                  "description": "Command id",
                  "index": 1,
                  "takesValue": true,
                  "required": true
                },
                {
                  "name": "window-id",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "window",
                  "description": "Target window id",
                  "takesValue": true
                },
                {
                  "name": "json",
                  "description": "Print JSON receipt"
                },
                {
                  "name": "timeout",
                  "description": "Deadline in milliseconds (default 30000)",
                  "takesValue": true
                }
              ]
            }
          }
        },
        "status": {
          "description": "Print CLI runtime status"
        },
        "version": {
          "description": "Print version information"
        }
      }
    },
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://damionx7.github.io/Zettel-Notes/install.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxM0I3MEY4RkI3QzIxQzMKUldURElYejcrSEE3WVZCaDFrOTlzRitaRGxMejBtVTNLVnJIeVcveFVLdEkveEFmeGJ6TU1sWjUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2023-present drl990114 (MarkFlowy); 2026-present damionx7 (Zettel Notes)",
    "shortDescription": "Markdown notes, compatible with Zettel Notes for Android",
    "longDescription": "Zettel Notes is a desktop Markdown editor for a Zettelkasten: notes linked by name, source and preview panes, gocryptfs-encrypted note folders and end-to-end encrypted notes, all compatible with Zettel Notes for Android. Custom themes, keyboard shortcuts and PDF export included.",
    "fileAssociations": [
      {
        "ext": [
          ".md",
          ".markdown",
          ".json",
          ".txt"
        ],
        "name": "Text Document",
        "description": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": {
      "../../../packages/theme/licenses/": "licenses/themes/"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      },
      "csp": null
    }
  }
}