{
  "version": 3,
  "pages404": true,
  "appType": "pages",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "locale": false,
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/zh/privacy",
      "destination": "/privacy",
      "locale": false,
      "statusCode": 308,
      "regex": "^(?!/_next)/zh/privacy(?:/)?$"
    },
    {
      "source": "/ru/privacy",
      "destination": "/privacy",
      "locale": false,
      "statusCode": 308,
      "regex": "^(?!/_next)/ru/privacy(?:/)?$"
    },
    {
      "source": "/ru/docs/:path+",
      "destination": "/docs/:path+",
      "locale": false,
      "statusCode": 307,
      "regex": "^(?!/_next)/ru/docs(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:nextInternalLocale(en|zh|ru)/api/cloud/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Vercel-Enable-Rewrite-Caching",
          "value": "0"
        }
      ],
      "regex": "^(?:/(en|zh|ru))/api/cloud(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/docs/:path*.md",
        "destination": "/en/raw-docs/en/:path*",
        "locale": false,
        "regex": "^/docs(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.md(?:/)?$"
      },
      {
        "source": "/en/docs/:path*.md",
        "destination": "/en/raw-docs/en/:path*",
        "locale": false,
        "regex": "^/en/docs(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.md(?:/)?$"
      },
      {
        "source": "/zh/docs/:path*.md",
        "destination": "/zh/raw-docs/zh/:path*",
        "locale": false,
        "regex": "^/zh/docs(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.md(?:/)?$"
      }
    ],
    "afterFiles": [
      {
        "source": "/:nextInternalLocale(en|zh|ru)/api/cloud/:path*",
        "destination": "https://api.markflowy.cc/:path*",
        "regex": "^(?:/(en|zh|ru))/api/cloud(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/docs/[...slug]",
      "regex": "^/docs/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/docs/(?<nxtPslug>.+?)(?:/)?$"
    },
    {
      "page": "/raw-docs/[...path]",
      "regex": "^/raw\\-docs/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/raw\\-docs/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/workspace/[...id]",
      "regex": "^/workspace/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/workspace/(?<nxtPid>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/auth",
      "regex": "^/auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth(?:/)?$"
    },
    {
      "page": "/auth/github/callback",
      "regex": "^/auth/github/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/github/callback(?:/)?$"
    },
    {
      "page": "/docs",
      "regex": "^/docs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/docs(?:/)?$"
    },
    {
      "page": "/llms.txt",
      "regex": "^/llms\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/llms\\.txt(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/releases",
      "regex": "^/releases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/releases(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/workspace",
      "regex": "^/workspace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workspace(?:/)?$"
    },
    {
      "page": "/workspace/settings/github",
      "regex": "^/workspace/settings/github(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workspace/settings/github(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/index\\.json$"
    },
    {
      "page": "/auth",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/auth\\.json$"
    },
    {
      "page": "/auth/github/callback",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/auth/github/callback\\.json$"
    },
    {
      "page": "/docs",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/docs\\.json$"
    },
    {
      "page": "/docs/[...slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/docs/(.+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/docs/(?<nxtPslug>.+?)\\.json$"
    },
    {
      "page": "/llms.txt",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/llms.txt\\.json$"
    },
    {
      "page": "/privacy",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/privacy\\.json$"
    },
    {
      "page": "/raw-docs/[...path]",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/raw\\-docs/(.+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/raw\\-docs/(?<nxtPpath>.+?)\\.json$"
    },
    {
      "page": "/releases",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/releases\\.json$"
    },
    {
      "page": "/settings",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/settings\\.json$"
    },
    {
      "page": "/sitemap.xml",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/sitemap.xml\\.json$"
    },
    {
      "page": "/workspace",
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/workspace\\.json$"
    },
    {
      "page": "/workspace/[...id]",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "dataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/workspace/(.+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/gkGDPu_ve674vvaprcQls/workspace/(?<nxtPid>.+?)\\.json$"
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      "en",
      "zh",
      "ru"
    ]
  },
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}